# ============================================================
# Admin Folder .htaccess
# ============================================================

# Prevent directory listing
Options -Indexes

# ------------------------------------------------------------
# Allow access to web files
# ------------------------------------------------------------

<FilesMatch "\.(php|html|css|js|png|jpg|jpeg|gif|ico|svg|webp)$">
    Require all granted
</FilesMatch>

# ------------------------------------------------------------
# ModSecurity
# ------------------------------------------------------------

<IfModule mod_security.c>
    SecRuleEngine Off
</IfModule>

# ------------------------------------------------------------
# Allow GET and POST
# ------------------------------------------------------------

<Limit GET POST>
    Require all granted
</Limit>

# ------------------------------------------------------------
# CORS for location_tracker.php
# ------------------------------------------------------------

<Files "location_tracker.php">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type"
    </IfModule>
</Files>

# ------------------------------------------------------------
# Disable caching for PHP files
# ------------------------------------------------------------

<FilesMatch "\.php$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# Custom Error Pages
# ------------------------------------------------------------

ErrorDocument 403 /admin/admin_login.php
ErrorDocument 404 /admin/dashboard.php

# ------------------------------------------------------------
# Admin logic files
# ------------------------------------------------------------

<FilesMatch "^(admin_auth\.php|.*_logic\.php)$">
    Require all granted
</FilesMatch>